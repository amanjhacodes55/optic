# Password for the dashboard. Required in production.
OPTIC_PASSWORD=change-me
# Secret used to sign session cookies. Any long random string (openssl rand -hex 32).
OPTIC_SECRET=
# Where the SQLite database lives. Defaults to ./data/optic.db
# OPTIC_DB=/data/optic.db
# Read-only public dashboards (for a hosted demo). Writes stay protected by the password.
# OPTIC_DEMO_MODE=1
# Docker only: load the Northwind Coffee demo data on first start.
# OPTIC_SEED_DEMO=1
