# Accounts: anyone can sign up by default. Set to false after creating your own account
# (the first account can always be created).
OPTIC_ALLOW_SIGNUP=true
# Where the SQLite database lives. Defaults to ./data/optic.db
# OPTIC_DB=/data/optic.db
# Docker only: load the Northwind Coffee demo data on first start.
# OPTIC_SEED_DEMO=1
# Hosted database (Turso). Required on serverless hosts such as Netlify, which have no lasting disk.
# When set, OPTIC_DB is ignored.
# TURSO_DATABASE_URL=libsql://optic-<you>.turso.io
# TURSO_AUTH_TOKEN=
